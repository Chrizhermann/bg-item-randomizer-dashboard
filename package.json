{
  "name": "bg-item-randomizer-dashboard",
  "private": true,
  "version": "0.2.0-alpha",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "extract-data": "tsx scripts/extract-data.ts",
    "package": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.bg-randomizer.dashboard",
    "productName": "BG Randomizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "portable": {
      "artifactName": "BG-Randomizer-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "BG-Randomizer-Setup-${version}.exe"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "public/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "public/icon.png",
      "category": "Game"
    },
    "dmg": { "artifactName": "BG-Randomizer-${version}.dmg" },
    "appImage": { "artifactName": "BG-Randomizer-${version}.AppImage" }
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
